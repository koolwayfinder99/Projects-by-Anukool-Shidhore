<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_6dof">

  <!-- ============================= 
       ROBOT PARAMETERS AND MACROS
       ============================= -->
  
  <xacro:property name="base_mass" value="5.0"/>
  <xacro:property name="link_mass" value="1.5"/>
  <xacro:property name="tool_mass" value="0.5"/>
  <xacro:property name="pi" value="3.14159265359"/>

  <!-- Macro for creating a revolute joint -->
  <xacro:macro name="revolute_joint" params="name parent child origin_xyz origin_rpy axis effort velocity">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <axis xyz="${axis}"/>
      <limit effort="${effort}" velocity="${velocity}" lower="-${pi}" upper="${pi}"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- Macro for creating a link with inertia -->
  <xacro:macro name="link_with_inertia" params="name mass">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${mass * 0.01}" ixy="0" ixz="0" iyy="${mass * 0.01}" iyz="0" izz="${mass * 0.01}"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://arm_6dof_description/meshes/link_${name}.stl" scale="1 1 1"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://arm_6dof_description/meshes/link_${name}.stl" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ============================= 
       ROBOT STRUCTURE DEFINITION
       ============================= -->

  <!-- Base Link (World/Fixed Base) -->
  <link name="base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: Base to Link 1 (Waist Joint) -->
  <xacro:revolute_joint name="joint_1" parent="base_link" child="link_1" 
                        origin_xyz="0 0 0.1" origin_rpy="0 0 0" 
                        axis="0 0 1" effort="150" velocity="3.14"/>
  
  <xacro:link_with_inertia name="link_1" mass="${link_mass}"/>

  <!-- Joint 2: Link 1 to Link 2 (Shoulder Joint) -->
  <xacro:revolute_joint name="joint_2" parent="link_1" child="link_2" 
                        origin_xyz="0 0 0.15" origin_rpy="0 0 0" 
                        axis="0 1 0" effort="150" velocity="3.14"/>
  
  <xacro:link_with_inertia name="link_2" mass="${link_mass}"/>

  <!-- Joint 3: Link 2 to Link 3 (Upper Arm Joint) -->
  <xacro:revolute_joint name="joint_3" parent="link_2" child="link_3" 
                        origin_xyz="0 0.15 0" origin_rpy="0 0 0" 
                        axis="0 1 0" effort="120" velocity="3.14"/>
  
  <xacro:link_with_inertia name="link_3" mass="${link_mass}"/>

  <!-- Joint 4: Link 3 to Link 4 (Wrist 1 Joint) -->
  <xacro:revolute_joint name="joint_4" parent="link_3" child="link_4" 
                        origin_xyz="0 0.15 0" origin_rpy="0 0 0" 
                        axis="0 1 0" effort="100" velocity="4.71"/>
  
  <xacro:link_with_inertia name="link_4" mass="${link_mass}"/>

  <!-- Joint 5: Link 4 to Link 5 (Wrist 2 Joint) -->
  <xacro:revolute_joint name="joint_5" parent="link_4" child="link_5" 
                        origin_xyz="0 0.1 0" origin_rpy="0 0 0" 
                        axis="0 0 1" effort="100" velocity="4.71"/>
  
  <xacro:link_with_inertia name="link_5" mass="${link_mass}"/>

  <!-- Joint 6: Link 5 to Link 6 (Wrist 3 Joint) -->
  <xacro:revolute_joint name="joint_6" parent="link_5" child="link_6" 
                        origin_xyz="0 0 0.1" origin_rpy="0 0 0" 
                        axis="0 1 0" effort="80" velocity="4.71"/>
  
  <xacro:link_with_inertia name="link_6" mass="${link_mass}"/>

  <!-- End Effector Link (Tool Flange) -->
  <joint name="joint_ee" type="fixed">
    <parent link="link_6"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="ee_link">
    <inertial>
      <mass value="${tool_mass}"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.65 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================= 
       TRANSMISSION ELEMENTS (for Gazebo)
       ============================= -->
  
  <xacro:macro name="transmission" params="joint_name">
    <transmission name="${joint_name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint_name}_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:transmission joint_name="joint_1"/>
  <xacro:transmission joint_name="joint_2"/>
  <xacro:transmission joint_name="joint_3"/>
  <xacro:transmission joint_name="joint_4"/>
  <xacro:transmission joint_name="joint_5"/>
  <xacro:transmission joint_name="joint_6"/>

  <!-- ============================= 
       GAZEBO PLUGIN CONFIGURATION
       ============================= -->
  
  <gazebo reference="base_link">
    <static>true</static>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

</robot>
